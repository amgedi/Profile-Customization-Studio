# Dependencies and reproducible build output
node_modules/
**/dist/
**/target/
**/build/
**/gen/
coverage/
.vite/
*.tsbuildinfo
# Local installed builds and release staging (keep the installed app on disk)
/artifacts/
/release-staging/
/*.exe
*.msi
# Development evidence and local work
/outputs/
/work/
/test-output/
/playwright-report/
/test-results/
/logs/
/cache/
/.tmp/
/temp/
.codex/
*.log
*.tmp
*.bak
*.dmp
# Secrets; only the placeholder example is shared
.env
.env.*
!.env.example
# User content and recovery (fixtures can be deliberately retained)
*.pcsproj
!fixtures/**/*.pcsproj
/identity-kits/
/asset-library/
/project-history/
/exports/
/pcs-draft.json
/pcs-app-prefs.json
/pcs-startup-ok.json
/recent-projects.json
/launcher-settings.json
# OS and per-machine editor state
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json
